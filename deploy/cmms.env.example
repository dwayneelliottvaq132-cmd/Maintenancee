# /etc/cmms/cmms.env — shared by the API (cmms-api.service) and the Python worker timers.
# install.sh creates this file with random secrets on first install. Keep it chmod 640 root:cmms.

# --- Database ---
CMMS_DB_URL=jdbc:postgresql://localhost:5432/cmms
CMMS_DB_USER=cmms
CMMS_DB_PASSWORD=change-me

# --- API ---
CMMS_BIND=127.0.0.1
CMMS_PORT=8080
# At least 32 random characters. Changing it logs everyone out.
CMMS_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CMMS_JWT_HOURS=12
# Password for the first 'admin' account (only used when the users table is empty)
CMMS_ADMIN_PASSWORD=change-me
CMMS_UPLOAD_DIR=/var/lib/cmms/uploads
CMMS_REPORT_DIR=/var/lib/cmms/reports

# --- Worker / email alerts (leave CMMS_SMTP_HOST empty to only log alerts) ---
CMMS_APP_URL=http://your-server
CMMS_SMTP_HOST=
CMMS_SMTP_PORT=587
CMMS_SMTP_STARTTLS=true
CMMS_SMTP_USER=
CMMS_SMTP_PASSWORD=
CMMS_SMTP_FROM=maintenance@your-company.com
CMMS_DUE_SOON_DAYS=3

# --- Backups ---
CMMS_BACKUP_DIR=/var/backups/cmms
CMMS_BACKUP_KEEP_DAYS=30
