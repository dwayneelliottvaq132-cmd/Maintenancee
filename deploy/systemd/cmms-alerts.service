[Unit]
Description=CMMS: email alerts
After=postgresql.service

[Service]
Type=oneshot
User=cmms
Group=cmms
EnvironmentFile=/etc/cmms/cmms.env
WorkingDirectory=/opt/cmms/worker
ExecStart=/opt/cmms/worker/.venv/bin/python -m cmms_worker alerts
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cmms /var/backups/cmms
